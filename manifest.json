{
  "manifest_version": 3,
  "name": "CHSM Admin",
  "version": "0.1.0",
  "description": "Управление пользователями CHSM",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://chsm-server.shk.solutions/*",
    "http://localhost:5008/*" 
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}